{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devsamurai/quick-replay/spec/quickreplay.schema.json",
  "title": "Quick Replay script v1",
  "type": "object",
  "required": ["format", "name", "platform", "steps"],
  "properties": {
    "format": { "const": "quickreplay/v1" },
    "name": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["android", "browser"] },
    "repeat": { "type": "integer", "minimum": 0, "default": 1 },
    "loopDelayMs": { "type": "integer", "minimum": 0, "default": 0 },
    "screen": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "startUrl": { "type": "string" },
    "createdAt": { "type": "string" },
    "pad": {
      "$ref": "#/$defs/pad",
      "description": "android, PAD fork: setup used by every solve step; required when a solve step is present"
    },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
  },
  "if": { "properties": { "platform": { "const": "android" } } },
  "then": {
    "required": ["screen"],
    "properties": {
      "steps": { "items": { "properties": { "type": { "enum": ["tap", "longPress", "swipe", "wait", "solve"] } } } }
    }
  },
  "else": {
    "properties": {
      "steps": {
        "items": { "properties": { "type": { "enum": ["navigate", "click", "type", "key", "scroll", "wait"] } } }
      }
    }
  },
  "$defs": {
    "delay": { "type": "integer", "minimum": 0 },
    "goal": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "enum": ["row", "column", "square", "cross", "lshape", "tpa"] },
            "color": { "enum": ["R", "B", "G", "L", "D", "H"] }
          },
          "required": ["type", "color"]
        },
        {
          "type": "object",
          "properties": { "type": { "const": "combos" }, "count": { "type": "integer", "minimum": 1 } },
          "required": ["type", "count"]
        }
      ]
    },
    "pad": {
      "type": "object",
      "required": ["goals"],
      "properties": {
        "goals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/goal" } },
        "rows": { "type": "integer", "minimum": 3, "maximum": 9, "default": 5 },
        "cols": { "type": "integer", "minimum": 3, "maximum": 9, "default": 6 },
        "diagonals": { "type": "boolean", "default": true },
        "maxMoves": { "type": "integer", "minimum": 1, "maximum": 50, "default": 40 },
        "timeLimitMs": { "type": "integer", "minimum": 100, "maximum": 10000, "default": 3000 },
        "msPerMove": { "type": "integer", "minimum": 10, "maximum": 1000, "default": 150 },
        "whenUnmet": { "enum": ["fail", "dragBest"], "default": "fail" }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y", "t"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "t": { "type": "integer", "minimum": 0 }
      }
    },
    "step": {
      "type": "object",
      "required": ["type"],
      "properties": { "delayBeforeMs": { "$ref": "#/$defs/delay" } },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "tap" },
            "x": { "type": "number" }, "y": { "type": "number" },
            "durationMs": { "type": "integer", "minimum": 1 }
          },
          "required": ["type", "x", "y"]
        },
        {
          "properties": {
            "type": { "const": "longPress" },
            "x": { "type": "number" }, "y": { "type": "number" },
            "durationMs": { "type": "integer", "minimum": 1 }
          },
          "required": ["type", "x", "y", "durationMs"]
        },
        {
          "properties": {
            "type": { "const": "swipe" },
            "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } }
          },
          "required": ["type", "points"]
        },
        {
          "properties": { "type": { "const": "wait" }, "ms": { "type": "integer", "minimum": 0 } },
          "required": ["type", "ms"]
        },
        {
          "description": "android, PAD fork: read the board on screen, solve it with the script's pad setup and drag the path",
          "properties": { "type": { "const": "solve" } },
          "required": ["type"]
        },
        {
          "properties": { "type": { "const": "navigate" }, "url": { "type": "string" } },
          "required": ["type", "url"]
        },
        {
          "properties": {
            "type": { "const": "click" },
            "selector": { "type": "string" },
            "x": { "type": "number" }, "y": { "type": "number" },
            "button": { "enum": ["left", "middle", "right"] },
            "clickCount": { "type": "integer", "minimum": 1 }
          },
          "required": ["type", "x", "y"]
        },
        {
          "properties": {
            "type": { "const": "type" },
            "selector": { "type": "string" },
            "text": { "type": "string" },
            "sensitive": { "type": "boolean", "description": "Password field: the value was not recorded" }
          },
          "required": ["type", "selector", "text"]
        },
        {
          "properties": { "type": { "const": "key" }, "key": { "type": "string", "minLength": 1 } },
          "required": ["type", "key"]
        },
        {
          "properties": {
            "type": { "const": "scroll" },
            "x": { "type": "number" }, "y": { "type": "number" }
          },
          "required": ["type", "x", "y"]
        }
      ]
    }
  }
}
