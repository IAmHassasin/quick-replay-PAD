{
  "description": "Test cases proposed in docs/MATCHING-STYLES.md for the goal types the solver does not support yet. Boards are 6x5 (rows top to bottom), goals use the proposed JSON, paths are cell indices (row * 6 + col). Checked by verify-proposed-cases.mjs; not part of any test suite.",
  "boards": {
    "BLOB": "RRBRRG\nGLRDHB\nBGLDHL\nHDBGLR\nLBHGDB",
    "THREE": "RLRRBB\nGDHBHD\nHGGDGL\nLHBLDR\nDBLHRG",
    "RBG": "RBGRBG\nBGRBGR\nGRBGRB\nRBGRBG\nLDHLDH",
    "TEE": "BDGLRH\nGDBHLR\nDHDGBL\nLDRBGH\nRBLHDG",
    "TWICE": "RRBRGL\nGRLHBD\nRHRBLG\nBLGDHB\nDGHLRH"
  },
  "cases": [
    {
      "id": "blob-min-solved",
      "style": "blob_min",
      "board": "BLOB",
      "goals": [{ "type": "blob", "color": "R", "min": 5 }],
      "expected": { "status": "solved", "path": [8, 2], "combos": [{ "color": "R", "size": 5 }] },
      "note": "One move up completes R R R R R in row 0; the sixth R at (3,5) is not connected."
    },
    {
      "id": "blob-min-impossible",
      "style": "blob_min",
      "board": "BLOB",
      "goals": [{ "type": "blob", "color": "H", "min": 5 }],
      "expected": { "status": "impossible", "reasons": ["Heart: the goals need 5 orbs, the board has 4"] },
      "note": "Hand count: H at (1,4), (2,4), (3,0), (4,2) = 4."
    },
    {
      "id": "blob-exact-solved",
      "style": "blob_exact",
      "board": "BLOB",
      "goals": [{ "type": "blob", "color": "R", "min": 5, "max": 5 }],
      "expected": { "status": "solved", "path": [8, 2], "combos": [{ "color": "R", "size": 5 }] },
      "note": "Same path as blob-min-solved: the combo has exactly 5 orbs."
    },
    {
      "id": "blob-exact-impossible",
      "style": "blob_exact",
      "board": "BLOB",
      "goals": [{ "type": "blob", "color": "G", "min": 6, "max": 6 }],
      "expected": { "status": "impossible", "reasons": ["Wood: the goals need 6 orbs, the board has 5"] },
      "note": "Hand count: G at (0,5), (1,0), (2,1), (3,3), (4,3) = 5."
    },
    {
      "id": "colors-solved",
      "style": "rainbow",
      "board": "THREE",
      "goals": [{ "type": "colors", "count": 3 }],
      "expected": { "status": "solved", "path": [1, 2, 3, 9, 15, 14, 13], "combos": [{ "color": "R", "size": 3 }, { "color": "B", "size": 3 }, { "color": "G", "size": 3 }] },
      "note": "Holding the L at (0,1): right twice (R R R), down twice (B B B in row 0), left twice (G G G in row 2)."
    },
    {
      "id": "colors-impossible",
      "style": "rainbow",
      "board": "RBG",
      "goals": [{ "type": "colors", "count": 4 }],
      "expected": { "status": "impossible", "reasons": ["4+ colours: only 3 colours have 3 or more orbs (R, B, G), the goal needs 4"] },
      "note": "Hand count: R 8, B 8, G 8, L 2, D 2, H 2."
    },
    {
      "id": "colors-at-once-solved",
      "style": "colors_at_once",
      "board": "THREE",
      "goals": [{ "type": "blob", "color": "R", "min": 3 }, { "type": "blob", "color": "B", "min": 3 }],
      "expected": { "status": "solved", "path": [1, 2, 3, 9, 15, 14, 13], "combos": [{ "color": "R", "size": 3 }, { "color": "B", "size": 3 }, { "color": "G", "size": 3 }] },
      "note": "A fixed colour set is a list of blob goals with min 3; the same path meets both."
    },
    {
      "id": "colors-at-once-impossible",
      "style": "colors_at_once",
      "board": "RBG",
      "goals": [{ "type": "blob", "color": "L", "min": 3 }, { "type": "blob", "color": "D", "min": 3 }],
      "expected": { "status": "impossible", "reasons": ["Light: the goals need 3 orbs, the board has 2", "Dark: the goals need 3 orbs, the board has 2"] },
      "note": "Hand count: L at (4,0), (4,3); D at (4,1), (4,4)."
    },
    {
      "id": "same-color-combos-solved",
      "style": "same_color_combos",
      "board": "TWICE",
      "goals": [{ "type": "blob", "color": "R", "min": 3 }, { "type": "blob", "color": "R", "min": 3 }],
      "expected": { "status": "solved", "path": [3, 2, 1, 7, 13], "combos": [{ "color": "R", "size": 3 }, { "color": "R", "size": 3 }] },
      "note": "Holding the R at (0,3): left twice (row 0 becomes R R R), down twice (row 2 becomes R R R); row 1 (G H L) keeps the two combos apart."
    },
    {
      "id": "same-color-combos-impossible",
      "style": "same_color_combos",
      "board": "TWICE",
      "goals": [{ "type": "blob", "color": "D", "min": 3 }, { "type": "blob", "color": "D", "min": 3 }],
      "expected": { "status": "impossible", "reasons": ["Dark: the goals need 6 orbs, the board has 3"] },
      "note": "Hand count: D at (1,5), (3,3), (4,0) = 3."
    },
    {
      "id": "tshape-solved",
      "style": "tshape",
      "board": "TEE",
      "goals": [{ "type": "tshape", "color": "D" }],
      "expected": { "status": "solved", "path": [19, 13], "combos": [{ "color": "D", "size": 5, "shape": "tshape" }] },
      "note": "Moving the D at (3,1) up to (2,1) completes column 1 rows 0-2 and row 2 columns 0-2: a T with the stem pointing up."
    },
    {
      "id": "tshape-impossible",
      "style": "tshape",
      "board": "TEE",
      "goals": [{ "type": "tshape", "color": "R" }],
      "expected": { "status": "impossible", "reasons": ["Fire: the goals need 5 orbs, the board has 4"] },
      "note": "Hand count: R at (0,4), (1,5), (3,2), (4,0) = 4."
    }
  ],
  "tshapeDefinition": {
    "description": "comboHasShape('tshape', cells, 5, 6) on a 6x5 board: exactly 5 orbs, 3 in a line plus 2 more from the middle of that line, in any of the 4 orientations.",
    "cases": [
      { "cells": [[0, 0], [0, 1], [0, 2], [1, 1], [2, 1]], "expected": true, "note": "stem down" },
      { "cells": [[0, 1], [1, 1], [2, 0], [2, 1], [2, 2]], "expected": true, "note": "stem up" },
      { "cells": [[0, 0], [1, 0], [2, 0], [1, 1], [1, 2]], "expected": true, "note": "stem right" },
      { "cells": [[0, 2], [1, 2], [2, 2], [1, 1], [1, 0]], "expected": true, "note": "stem left" },
      { "cells": [[0, 0], [1, 0], [2, 0], [2, 1], [2, 2]], "expected": false, "note": "an L is not a T" },
      { "cells": [[0, 1], [1, 0], [1, 1], [1, 2], [2, 1]], "expected": false, "note": "a cross is not a T" },
      { "cells": [[0, 0], [0, 1], [0, 2], [1, 1], [2, 1], [3, 1]], "expected": false, "note": "6 orbs" },
      { "cells": [[0, 0], [0, 1], [0, 2], [0, 3], [1, 1]], "expected": false, "note": "4 in a line plus 1 is not a T" }
    ]
  }
}
