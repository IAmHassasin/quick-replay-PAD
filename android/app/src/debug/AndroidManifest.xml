<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb drive the app for automated demos and tests. DUMP is held by the
     adb shell but cannot be granted to third-party apps, so other apps cannot send commands. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools" />
    </application>
</manifest>
